# DeAI training settings, read by train.bat and train.sh.
#
# Copy this file to .env and edit it. .env is gitignored.
# One KEY=value per line, no spaces around "=", no quotes, no comments after a value.
# Lines starting with # are ignored; a commented-out or empty setting uses the trainer's default.
# Variables already set in your shell win over this file, and arguments passed to
# train.bat / train.sh win over both.

# --- Run ------------------------------------------------------------------------
# Run name; outputs go to runs/dpo-<run>/. Reusing a name resumes that run.
DEAI_RUN=r-quick-qwen3-4b
# Detector reward: quick | neural-quick | neural | stat | full
DEAI_REWARD=quick
# Number of best-of-N + DPO rounds (round 0, the zero-shot evaluation, is extra).
DEAI_ROUNDS=3

# --- Model and sampling ---------------------------------------------------------
# Hugging Face model id of the base rewriter.
# DEAI_BASE=Qwen/Qwen3-4B-Instruct-2507
# Rewrites sampled per training source.
# DEAI_N=8
# DEAI_TEMPERATURE=0.9
# Sequences per generate() call: 16 fits Qwen3-4B's KV cache, a 1.5B model takes 64.
# DEAI_GEN_BATCH=16
# Train sources per round / val sources (default: all). Small values make a smoke test.
# DEAI_TRAIN_LIMIT=
# DEAI_EVAL_LIMIT=

# --- DPO ------------------------------------------------------------------------
# DEAI_LR=2e-5
# DEAI_BETA=0.1
# DEAI_LORA_R=16
# e.g. sigmoid,sft for RPO-style regularisation
# DEAI_LOSS_TYPE=sigmoid
# DEAI_EFFECTIVE_BATCH=16

# Any other train_dpo flags, space-separated (see: python -m deai.train_dpo --help).
# DEAI_EXTRA_ARGS=--no-train-nli --skip-zero-shot

# --- Services -------------------------------------------------------------------
# Where the in-process detectors run: cuda or cpu (default: cuda when available).
# fp32: the 9 classifiers take ~6.7 GB of VRAM and gpt2-medium/distilgpt2 ~1.7 GB
# if all 23 engines load; the quick reward needs only 4. cpu is slower but frees it.
# DEAI_DETECTOR_DEVICE=cpu
# SlopBench corpus folder (default: data\slopbench, from scripts\fetch_slopbench.py).
# DEAI_SLOPBENCH=
# TensorBoard port.
# TB_PORT=6006

# --- Hugging Face ---------------------------------------------------------------
# Where models are downloaded and cached.
# HF_HOME=D:\hf-cache
